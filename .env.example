# Copy this file to .env and fill in your Supabase project details.
# Until these are set, the app runs entirely on mock data (see src/services/mockDataService.ts)
# and USE_SUPABASE below stays effectively off.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "true" once your Supabase schema (supabase/schema.sql) is applied
# and you're ready to move off mock data.
VITE_USE_SUPABASE=false
